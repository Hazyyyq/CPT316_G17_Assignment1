# Public test 2: while loops with a nested if
# Prints the factorial of 5, then counts the multiples of 3 from 1 to 12
let n = 5;
let fact = 1;
while (n > 1) {
    fact = fact * n;
    n = n - 1;
}
print(fact);

let i = 1;
let count = 0;
while (i <= 12) {
    if (i % 3 == 0) {
        count = count + 1;
    }
    i = i + 1;
}
print(count);
